<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SquadApplication.ViewCustom.ChatsListPage"
             Title="ChatsList">
    <!-- ==================== Вкладка Список чатов ==================== -->
    <StackLayout x:Name="ChatListTab" IsVisible="False" Spacing="0">
        <Border BackgroundColor="#16213e"
            Stroke="Transparent"
            Padding="12">
            <Label Text="Ваши чаты"
               FontSize="20"
               FontAttributes="Bold"
               TextColor="White"/>
        </Border>
        <!-- Поиск -->
        <Border BackgroundColor="#16213e"
            Stroke="Transparent"
            Padding="8">
            <Border BackgroundColor="#1a1a2e"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 10"
                Padding="8">
                <Entry Placeholder="🔍 Поиск чатов..."
                   PlaceholderColor="Gray"
                   TextColor="White"
                   BackgroundColor="Transparent"/>
            </Border>
        </Border>

        <!-- Список чатов -->
        <CollectionView VerticalOptions="FillAndExpand"
                    BackgroundColor="#1a1a2e">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#16213e"
                        Stroke="Transparent"
                        Padding="14"
                        Margin="8,4"
                        StrokeShape="RoundRectangle 12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                            <!-- Аватар -->
                            <Border Grid.Column="0"
                                WidthRequest="50"
                                HeightRequest="50"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 25"
                                BackgroundColor="#0f3460">
                                <Label Text="💬"
                                   FontSize="24"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                            </Border>

                            <!-- Инфо -->
                            <VerticalStackLayout Grid.Column="1" 
                                             VerticalOptions="Center" 
                                             Spacing="4">
                                <Label Text="Тактическая группа"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                                <Label Text="Командир: план на игру..."
                                   FontSize="13"
                                   TextColor="Gray"
                                   LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>

                            <!-- Время + счётчик -->
                            <VerticalStackLayout Grid.Column="2" 
                                             VerticalOptions="Center"
                                             HorizontalOptions="End"
                                             Spacing="6">
                                <Label Text="09:15"
                                   FontSize="11"
                                   TextColor="Gray"
                                   HorizontalOptions="End"/>
                                <Border BackgroundColor="#0f3460"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 10"
                                    WidthRequest="22"
                                    HeightRequest="22"
                                    HorizontalOptions="End">
                                    <Label Text="3"
                                       FontSize="11"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Кнопка создать чат -->
        <Border BackgroundColor="#16213e"
            Stroke="Transparent"
            Padding="12">
            <Button Text="+ Новый чат"
                BackgroundColor="#0f3460"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="10"
                HeightRequest="44"/>
        </Border>
    </StackLayout>
</ContentPage>