<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SquadApplication.ViewCustom.ChatPage"
             BackgroundImageSource="createevent.jpg"
             Title="ChatPage">

    <Grid RowDefinitions="Auto,*"  >

        <!-- Заголовок с вкладками -->
        <Border Grid.Row="0"
                Stroke="Transparent"
                BackgroundColor="#981a0a6e"
                Padding="10">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="5" >

                <!-- Вкладка Команда -->
                <Border Grid.Column="0"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="#91808020">
                    <Label Text="⚔️ Команда"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="AliceBlue"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Padding="10"/>
                </Border>

                <!-- Вкладка Чаты -->
                <Border Grid.Column="1"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="#99808020">
                    <Label Text="💬 Чаты"                           
                           FontSize="16"
                           FontAttributes="Bold"
                           BackgroundColor="#50808080"
                           TextColor="AliceBlue"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Padding="10"/>
                </Border>
            </Grid>
        </Border>

        <!-- Контент -->
        <Grid Grid.Row="1" >

            <!-- ==================== Вкладка Командный чат ==================== -->
            <StackLayout x:Name="TeamChatTab" Spacing="0">

                <!-- Панель действий -->
                <Border BackgroundColor="#90162132"
                        Stroke="Transparent"
                        Padding="8">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                        <Border 
                            StrokeShape="RoundRectangle 50"
                            >
                        <Button Grid.Column="0"
                                Text="←"
                                FontSize="20"
                                TextColor="White"
                                BackgroundColor="Transparent"
                                WidthRequest="40"
                                HeightRequest="40"/>
                            
                        </Border>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Командный чат"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                            <Label Text="5 участников"
                                   FontSize="12"
                                   TextColor="Gray"/>
                        </VerticalStackLayout>
                        <Border 
                            Grid.Column="2"
                            StrokeShape="RoundRectangle 50"
                                      >
                            <Button 
                                Text="🔍"
                                FontSize="18"
                                BackgroundColor="Transparent"
                                WidthRequest="40"
                                HeightRequest="40"/>
                        </Border>
                        <Border 
    Grid.Column="3"
    StrokeShape="RoundRectangle 50">
                            <Button 
                                Text="👥"
                                FontSize="18"
                                BackgroundColor="Transparent"
                                WidthRequest="40"
                                HeightRequest="40"/>
                        </Border>

                        <Border 
                              Grid.Column="4"
                              StrokeShape="RoundRectangle 50">
                        <Button Grid.Column="4"
                                Text="⋮"
                                FontSize="24"
                                TextColor="White"
                                BackgroundColor="Transparent"
                                WidthRequest="40"
                                HeightRequest="40"/>
                        </Border>
                    </Grid>
                </Border>
                <!-- Закреплённое сообщение -->
                <Border BackgroundColor="#993a0a4e"
                        Stroke="Transparent"
                        Padding="10">
                    <Grid ColumnDefinitions="Auto,*,Auto" >
                        <Label Grid.Column="0" 
                               Text="📌" 
                               FontSize="14" 
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1" 
                               Text="Сбор в субботу в 10:00! Не опаздывать."
                               TextColor="#a0a0c0"
                               FontSize="13"
                               LineBreakMode="TailTruncation"
                               Margin="8,0"/>
                        <Button Grid.Column="2"
                                Text="✕"
                                FontSize="14"
                                TextColor="Gray"
                                BackgroundColor="Transparent"
                                WidthRequest="30"
                                HeightRequest="30"/>
                    </Grid>
                </Border>
                <!-- Сообщения -->
                <CollectionView x:Name="MessagesList"
                                VerticalOptions="FillAndExpand"
                                BackgroundColor="#991a0a4e">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <!-- Своё сообщение (справа) -->
                            <Grid Padding="12,6">
                                <Border HorizontalOptions="End"
                                        MaximumWidthRequest="300"
                                        BackgroundColor="#0f3460"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="12,8">
                                    <VerticalStackLayout>
                                        <Label Text="Понял, буду!"
                                               FontSize="15"
                                               TextColor="White"/>
                                        <Label Text="12:34"
                                               FontSize="10"
                                               TextColor="#888"
                                               HorizontalOptions="End"
                                               Margin="0,4,0,0"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <!-- Строка ввода -->
                <Border BackgroundColor="#16213e"
                        Stroke="Transparent"
                        Padding="8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Border
                            StrokeThickness="0"
                            StrokeShape="50"
                            BackgroundColor="#981a0a6e"
                            >
                          <Button Grid.Column="0"
                                Text="📎"
                                FontSize="15"
                                BackgroundColor="Transparent"
                                WidthRequest="30"
                                HeightRequest="30"/>
                        </Border>

                        <Border Grid.Column="1"
                                BackgroundColor="#1a1a2e"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 20"
                                Padding="12,4">
                            <Entry Placeholder="Сообщение..."
                                   PlaceholderColor="Gray"
                                   TextColor="White"
                                   BackgroundColor="Transparent"/>
                        </Border>

                        <Button Grid.Column="2"
                                Text="➤"
                                FontSize="20"
                                TextColor="White"
                                BackgroundColor="#981a0a6e"
                                CornerRadius="20"
                                WidthRequest="44"
                                HeightRequest="44"/>
                    </Grid>
                </Border>
            </StackLayout>
            
        </Grid>
    </Grid>
</ContentPage>