<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SquadApplication.ViewCustom.ChatPage"
             Title="ChatPage">
    <Grid RowDefinitions="Auto,*">

        <!-- Заголовок с вкладками -->
        <Border Grid.Row="0"
                BackgroundColor="#16213e"
                Stroke="Transparent"
                Padding="10">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="5">

                <!-- Вкладка Команда -->
                <Border Grid.Column="0"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="#0f3460">
                    <Label Text="⚔️ Команда"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Padding="10"/>
                </Border>

                <!-- Вкладка Чаты -->
                <Border Grid.Column="1"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="Transparent">
                    <Label Text="💬 Чаты"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#888"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Padding="10"/>
                </Border>
            </Grid>
        </Border>

        <!-- Контент -->
        <Grid Grid.Row="1">

            <!-- ==================== Вкладка Командный чат ==================== -->
            <StackLayout x:Name="TeamChatTab" Spacing="0">

                <!-- Панель действий -->
                <Border BackgroundColor="#16213e"
                        Stroke="Transparent"
                        Padding="8">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">

                        <Button Grid.Column="0"
                                Text="←"
                                FontSize="20"
                                TextColor="White"
                                BackgroundColor="Transparent"
                                WidthRequest="40"
                                HeightRequest="40"/>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Командный чат"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                            <Label Text="5 участников"
                                   FontSize="12"
                                   TextColor="Gray"/>
                        </VerticalStackLayout>

                        <Button Grid.Column="2"
                                Text="🔍"
                                FontSize="18"
                                BackgroundColor="Transparent"
                                WidthRequest="40"
                                HeightRequest="40"/>

                        <Button Grid.Column="3"
                                Text="👥"
                                FontSize="18"
                                BackgroundColor="Transparent"
                                WidthRequest="40"
                                HeightRequest="40"/>

                        <Button Grid.Column="4"
                                Text="⋮"
                                FontSize="24"
                                TextColor="White"
                                BackgroundColor="Transparent"
                                WidthRequest="40"
                                HeightRequest="40"/>
                    </Grid>
                </Border>

                <!-- Закреплённое сообщение -->
                <Border BackgroundColor="#1a1a4e"
                        Stroke="Transparent"
                        Padding="10">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" 
                               Text="📌" 
                               FontSize="14" 
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1" 
                               Text="Сбор в субботу в 10:00! Не опаздывать."
                               TextColor="#a0a0c0"
                               FontSize="13"
                               LineBreakMode="TailTruncation"
                               Margin="8,0"/>
                        <Button Grid.Column="2"
                                Text="✕"
                                FontSize="14"
                                TextColor="Gray"
                                BackgroundColor="Transparent"
                                WidthRequest="30"
                                HeightRequest="30"/>
                    </Grid>
                </Border>

                <!-- Сообщения -->
                <CollectionView x:Name="MessagesList"
                                VerticalOptions="FillAndExpand"
                                BackgroundColor="#1a1a2e">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <!-- Своё сообщение (справа) -->
                            <Grid Padding="12,6">
                                <Border HorizontalOptions="End"
                                        MaximumWidthRequest="300"
                                        BackgroundColor="#0f3460"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="12,8">
                                    <VerticalStackLayout>
                                        <Label Text="Понял, буду!"
                                               FontSize="15"
                                               TextColor="White"/>
                                        <Label Text="12:34"
                                               FontSize="10"
                                               TextColor="#888"
                                               HorizontalOptions="End"
                                               Margin="0,4,0,0"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Строка ввода -->
                <Border BackgroundColor="#16213e"
                        Stroke="Transparent"
                        Padding="8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">

                        <Button Grid.Column="0"
                                Text="📎"
                                FontSize="20"
                                BackgroundColor="Transparent"
                                WidthRequest="40"
                                HeightRequest="40"/>

                        <Border Grid.Column="1"
                                BackgroundColor="#1a1a2e"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 20"
                                Padding="12,4">
                            <Entry Placeholder="Сообщение..."
                                   PlaceholderColor="Gray"
                                   TextColor="White"
                                   BackgroundColor="Transparent"/>
                        </Border>

                        <Button Grid.Column="2"
                                Text="➤"
                                FontSize="20"
                                TextColor="White"
                                BackgroundColor="#0f3460"
                                CornerRadius="20"
                                WidthRequest="44"
                                HeightRequest="44"/>
                    </Grid>
                </Border>
            </StackLayout>

            <!-- ==================== Вкладка Список чатов ==================== -->
            <StackLayout x:Name="ChatListTab" IsVisible="False" Spacing="0">

                <Border BackgroundColor="#16213e"
                        Stroke="Transparent"
                        Padding="12">
                    <Label Text="Ваши чаты"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="White"/>
                </Border>

                <!-- Поиск -->
                <Border BackgroundColor="#16213e"
                        Stroke="Transparent"
                        Padding="8">
                    <Border BackgroundColor="#1a1a2e"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 10"
                            Padding="8">
                        <Entry Placeholder="🔍 Поиск чатов..."
                               PlaceholderColor="Gray"
                               TextColor="White"
                               BackgroundColor="Transparent"/>
                    </Border>
                </Border>

                <!-- Список чатов -->
                <CollectionView VerticalOptions="FillAndExpand"
                                BackgroundColor="#1a1a2e">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="#16213e"
                                    Stroke="Transparent"
                                    Padding="14"
                                    Margin="8,4"
                                    StrokeShape="RoundRectangle 12">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                    <!-- Аватар -->
                                    <Border Grid.Column="0"
                                            WidthRequest="50"
                                            HeightRequest="50"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 25"
                                            BackgroundColor="#0f3460">
                                        <Label Text="💬"
                                               FontSize="24"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Border>

                                    <!-- Инфо -->
                                    <VerticalStackLayout Grid.Column="1" 
                                                         VerticalOptions="Center" 
                                                         Spacing="4">
                                        <Label Text="Тактическая группа"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="White"/>
                                        <Label Text="Командир: план на игру..."
                                               FontSize="13"
                                               TextColor="Gray"
                                               LineBreakMode="TailTruncation"/>
                                    </VerticalStackLayout>

                                    <!-- Время + счётчик -->
                                    <VerticalStackLayout Grid.Column="2" 
                                                         VerticalOptions="Center"
                                                         HorizontalOptions="End"
                                                         Spacing="6">
                                        <Label Text="09:15"
                                               FontSize="11"
                                               TextColor="Gray"
                                               HorizontalOptions="End"/>
                                        <Border BackgroundColor="#0f3460"
                                                Stroke="Transparent"
                                                StrokeShape="RoundRectangle 10"
                                                WidthRequest="22"
                                                HeightRequest="22"
                                                HorizontalOptions="End">
                                            <Label Text="3"
                                                   FontSize="11"
                                                   TextColor="White"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Кнопка создать чат -->
                <Border BackgroundColor="#16213e"
                        Stroke="Transparent"
                        Padding="12">
                    <Button Text="+ Новый чат"
                            BackgroundColor="#0f3460"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="44"/>
                </Border>
            </StackLayout>
        </Grid>
    </Grid>
</ContentPage>